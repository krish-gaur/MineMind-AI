# Copy to backend/.env for local development. Never commit a real .env file.
# Every value below is optional; the defaults run the demo offline-safe.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API directly from a browser.
# The default Next.js proxy does not need this.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex, e.g. for Vercel preview deployments.
CORS_ORIGIN_REGEX=

# Storage (defaults: backend/data_store and backend/artifacts). Ephemeral on Render unless mounted on a disk.
# DATA_DIR=
# ARTIFACTS_DIR=

MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=50000
STALE_DATA_DAYS=14

# Public services are keyless. Set false to skip all outbound calls (offline demonstration mode).
ENABLE_EXTERNAL_SERVICES=true
EXTERNAL_TIMEOUT_S=8
EXTERNAL_CACHE_TTL_H=24
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

FORECAST_HORIZON_DAYS=30

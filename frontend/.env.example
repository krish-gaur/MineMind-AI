# Copy to .env.local for local development (never commit real .env files).
# Backend the Next.js dev server proxies /api/* to (no trailing slash).
BACKEND_URL=http://127.0.0.1:8000

# Optional. Leave empty to use the same-origin /api proxy (recommended).
# Set only if the browser must call the API directly (backend CORS_ORIGINS must include this site).
NEXT_PUBLIC_API_BASE_URL=

# Optional. MapLibre style URL for an online basemap. Empty = offline outline basemap.
# Example (OpenFreeMap, attribution required): https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=
